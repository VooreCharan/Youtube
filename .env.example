# ============================================================
# YouTube Automation System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# ---------- AI (LLM) fallback chain ----------
# Providers are tried in this order; any without a key is skipped.
# If one fails (down, rate-limited, bad key, broken answer) the next one is used.
# Ordered by free allowance (most generous first). Add as many free keys as you can.
LLM_CHAIN=groq,gemini,openrouter_free,github,openai,openrouter

GEMINI_API_KEY=                         # free: https://aistudio.google.com/apikey  (also used for Veo)
GROQ_API_KEY=                           # free: https://console.groq.com/keys
OPENROUTER_API_KEY=                     # free models need only a key: https://openrouter.ai/keys
GITHUB_TOKEN=                           # free: github.com/settings/tokens (fine-grained, "Models: read")
OPENAI_API_KEY=                         # PAID fallback: https://platform.openai.com/api-keys

# Optional: models tried per provider, in order (defaults shown)
# GEMINI_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.1-flash-lite
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# OPENROUTER_FREE_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
# GITHUB_MODELS=openai/gpt-4.1-mini
# OPENAI_MODELS=gpt-5.4-mini,gpt-4.1-mini
OPENROUTER_MODEL=google/gemini-2.5-pro  # PAID last resort (only used if all free ones fail)

# Optional: local Ollama — add "ollama" to LLM_CHAIN to use it
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434

# Timing: per-model timeout, total wait per request, extra retry rounds for overloaded providers
# LLM_TIMEOUT=90
# LLM_MAX_WAIT=240
# LLM_RETRY_ROUNDS=2

# ---------- YouTube ----------
YOUTUBE_CLIENT_SECRETS_PATH=client_secrets.json

# ---------- Telegram bot ----------
TELEGRAM_BOT_TOKEN=                     # from @BotFather
TELEGRAM_ALLOWED_USERS=                 # your Telegram user ID(s), comma-separated. The bot tells you yours.
TELEGRAM_CHAT_ID=                       # optional: chat for scheduler notifications
TOPICS_PER_PAGE=8                       # topic ideas per batch

# ---------- Publishing ----------
YOUTUBE_PRIVACY=public                  # public | unlisted | private (used after you approve in Telegram)

# ---------- Media Generation ----------
MEDIA_PROVIDER=pexels                   # pexels | veo (Veo uses GEMINI_API_KEY above; paid & slow)
PEXELS_API_KEY=                         # Free API key from pexels.com

# ---------- Whisper / Subtitles ----------
WHISPER_MODEL_SIZE=base                 # local fallback: base | medium | large-v3
GROQ_WHISPER_MODEL=whisper-large-v3     # hosted speech-to-text, used first when GROQ_API_KEY is set

# ---------- TTS ----------
DEFAULT_VOICE=en-US-AvaNeural           # Edge-TTS voice name (API/dashboard default)

# ---------- Video ----------
DEFAULT_VIDEO_FORMAT=horizontal         # horizontal | vertical

# ---------- Database ----------
DB_PATH=data/youtube_automation.db

# ---------- Logging ----------
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# ---------- Scheduler ----------
ENABLE_SCHEDULER=false                  # true = unattended daily generate + upload (skips Telegram approval)
GENERATION_HOUR=8                       # Hour (24h) to auto-generate videos
UPLOAD_HOUR=10                          # Hour (24h) to auto-upload ready videos

# ---------- Server ----------
API_HOST=0.0.0.0
API_PORT=8000
