# ============================================================
# YouTube Automation System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# ---------- LLM ----------
LLM_PROVIDER=openrouter                 # openrouter | ollama
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-pro
OLLAMA_MODEL=llama3                     # Only used if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434  # Ollama API base URL

# ---------- YouTube ----------
YOUTUBE_CLIENT_SECRETS_PATH=client_secrets.json

# ---------- Telegram (optional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Media Generation ----------
MEDIA_PROVIDER=pexels                   # pexels | veo
GEMINI_API_KEY=                         # API key for Google Veo (Gemini)
PEXELS_API_KEY=                         # Free API key from pexels.com

# ---------- Whisper / Subtitles ----------
WHISPER_MODEL_SIZE=base                 # base | medium | large-v3

# ---------- TTS ----------
DEFAULT_VOICE=en-US-AvaNeural           # Edge-TTS voice name

# ---------- Video ----------
DEFAULT_VIDEO_FORMAT=horizontal         # horizontal | vertical

# ---------- Database ----------
DB_PATH=data/youtube_automation.db

# ---------- Logging ----------
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# ---------- Scheduler ----------
GENERATION_HOUR=8                       # Hour (24h) to auto-generate videos
UPLOAD_HOUR=10                          # Hour (24h) to auto-upload ready videos

# ---------- Server ----------
API_HOST=0.0.0.0
API_PORT=8000
